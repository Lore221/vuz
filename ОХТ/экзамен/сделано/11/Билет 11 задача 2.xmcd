			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Увеличиваем производительность по компоненту С на 10%</p>
			</text>
		</region>
		<region region-id="181" left="12" top="728.25" width="240" height="27.75" align-x="36" align-y="744" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
