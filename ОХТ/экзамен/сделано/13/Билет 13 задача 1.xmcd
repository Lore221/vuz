										<ml:id xml:space="preserve">X</ml:id>
									</ml:apply>
									<ml:real>2</ml:real>
								</ml:apply>
							</ml:apply>
							<ml:apply>
								<ml:pow/>
								<ml:id xml:space="preserve">P</ml:id>
								<ml:real>-1</ml:real>
							</ml:apply>
						</ml:apply>
						<ml:apply>
							<ml:mult/>
							<ml:apply>
								<ml:pow/>
								<ml:apply>
									<ml:id xml:space="preserve">ZEC</ml:id>
									<ml:id xml:space="preserve">X</ml:id>
								</ml:apply>
