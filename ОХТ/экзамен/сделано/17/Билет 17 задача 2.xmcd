		<region region-id="90" left="24" top="525" width="177.75" height="18.75" align-x="76.5" align-y="540" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:function>
						<ml:id xml:space="preserve">U1</ml:id>
						<ml:boundVars>
							<ml:id xml:space="preserve">T</ml:id>
							<ml:id xml:space="preserve">P</ml:id>
							<ml:id xml:space="preserve">X</ml:id>
						</ml:boundVars>
					</ml:function>
					<ml:apply>
						<ml:mult/>
						<ml:apply>
							<ml:mult/>
							<ml:apply>
								<ml:mult/>
								<ml:apply>
									<ml:id xml:space="preserve">K1</ml:id>
									<ml:id xml:space="preserve">T</ml:id>
								</ml:apply>
								<ml:apply>
									<ml:pow/>
									<ml:apply>
										<ml:id xml:space="preserve">ZEA</ml:id>
										<ml:id xml:space="preserve">X</ml:id>
									</ml:apply>
									<ml:real>2</ml:real>
