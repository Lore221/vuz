									</ml:apply>
									<ml:real>2</ml:real>
								</ml:apply>
							</ml:apply>
							<ml:apply>
								<ml:pow/>
								<ml:id xml:space="preserve">P</ml:id>
								<ml:real>-2</ml:real>
							</ml:apply>
						</ml:apply>
