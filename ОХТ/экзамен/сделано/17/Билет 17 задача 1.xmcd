							<ml:id xml:space="preserve">P</ml:id>
							<ml:id xml:space="preserve">X</ml:id>
						</ml:boundVars>
					</ml:function>
					<ml:apply>
						<ml:minus/>
						<ml:apply>
							<ml:mult/>
							<ml:apply>
								<ml:mult/>
								<ml:apply>
									<ml:id xml:space="preserve">KP</ml:id>
									<ml:id xml:space="preserve">T</ml:id>
