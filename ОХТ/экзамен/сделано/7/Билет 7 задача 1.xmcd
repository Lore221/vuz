		<region region-id="61" left="18" top="495" width="270.75" height="18.75" align-x="72" align-y="510" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:function>
						<ml:id xml:space="preserve">EQ</ml:id>
						<ml:boundVars>
							<ml:id xml:space="preserve">X</ml:id>
							<ml:id xml:space="preserve">T</ml:id>
							<ml:id xml:space="preserve">P</ml:id>
						</ml:boundVars>
					</ml:function>
					<ml:apply>
						<ml:minus/>
						<ml:apply>
							<ml:mult/>
							<ml:apply>
								<ml:mult/>
								<ml:apply>
									<ml:mult/>
									<ml:apply>
										<ml:id xml:space="preserve">Kp</ml:id>
										<ml:id xml:space="preserve">T</ml:id>
									</ml:apply>
									<ml:apply>
										<ml:id xml:space="preserve">ZEA</ml:id>
										<ml:id xml:space="preserve">X</ml:id>
									</ml:apply>
								</ml:apply>
								<ml:apply>
									<ml:pow/>
									<ml:apply>
										<ml:id xml:space="preserve">ZEB</ml:id>
										<ml:id xml:space="preserve">X</ml:id>
									</ml:apply>
									<ml:real>2</ml:real>
								</ml:apply>
							</ml:apply>
							<ml:apply>
								<ml:pow/>
								<ml:id xml:space="preserve">P</ml:id>
								<ml:real>-4</ml:real>
							</ml:apply>
						</ml:apply>
						<ml:apply>
							<ml:mult/>
							<ml:apply>
								<ml:pow/>
								<ml:apply>
									<ml:id xml:space="preserve">ZEC</ml:id>
									<ml:id xml:space="preserve">X</ml:id>
								</ml:apply>
								<ml:real>4</ml:real>
							</ml:apply>
							<ml:apply>
								<ml:pow/>
								<ml:apply>
									<ml:id xml:space="preserve">ZED</ml:id>
									<ml:id xml:space="preserve">X</ml:id>
								</ml:apply>
								<ml:real>3</ml:real>
							</ml:apply>
						</ml:apply>
					</ml:apply>
				</ml:define>
			</math>
