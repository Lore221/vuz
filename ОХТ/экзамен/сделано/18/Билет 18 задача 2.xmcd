		<region region-id="172" left="24" top="852" width="313.5" height="218.25" align-x="24" align-y="852" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<plot disable-calc="false" item-idref="30"/>
