				<p style="Normal" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Температурная зависимость константы равновесия</p>
			</text>
		</region>
		<region region-id="23" left="42" top="432" width="92.25" height="33.75" align-x="74.25" align-y="462" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
